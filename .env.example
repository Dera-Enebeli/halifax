# SMTP configuration for lead email notifications
# Lead data will be logged to server console even without these.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
NOTIFY_TO=Enebly@aol.com

# Google Analytics (optional — leave empty to disable)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Your production URL (used for sitemap, OG tags, SEO)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
